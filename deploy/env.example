# Under a Dark Star: the production environment file (docs/DarkStar-Launch.md
# H3, docs/DarkStar-Accounts.md §11). Lives at /opt/darkstar/.env on the
# server, never in the repository. Everything below except DEPLOY_BRANCH and
# TUNNEL_TOKEN is the containers' environment (docker-compose.yml env_file).

# --- Deploy ---------------------------------------------------------------
# The branch deploy.sh pulls and builds.
DEPLOY_BRANCH=main
# The Cloudflare tunnel's token (Zero Trust > Networks > Tunnels). Secret.
TUNNEL_TOKEN=

# --- The game and the account API ----------------------------------------
GAME_ENV=prod
# The site, and the API's own hostname (Launch §6.2: a sibling name, because
# the free certificate covers one level under january-games.com).
DOMAIN=darkstar.january-games.com
API_DOMAIN=darkstar-api.january-games.com
# One game worker per core is plenty: the simulation runs in the browsers.
NUM_WORKERS=2
# The first letter of every game id this server mints.
INSTANCE_LETTER=a
# Shared by the game server and the API for server-to-server calls. A long
# random string (openssl rand -hex 32). Secret.
API_KEY=
# Cloudflare Turnstile, the join bot check (the site key is public, the
# secret is not).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Discord sign-in (the Discord developer application). The secret is secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google sign-in (the Google Cloud OAuth client, docs/DarkStar-Services.md
# §2.5). Optional: leave both empty and Google is not offered. The secret is
# secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The account database and signing key, on the darkstar-data volume.
DATA_DIR=/data

# Left unset on purpose: CDN_BASE (assets come from the game server itself),
# RANKED_MATCHMAKING (off), SUBDOMAIN / GAME_HOST / SITE_HOST (one server, no
# cluster), ADMIN_BOT_API_KEY (no admin bot), STRIPE_* (no store).
